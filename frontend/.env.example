# ─────────────────────────────────────────────────────────────────────────────
# AfriPay Frontend — environment variables
#
# Copy this file to .env (never commit .env) and fill in the values below.
# All variables must be prefixed with REACT_APP_ to be embedded at build time.
# ─────────────────────────────────────────────────────────────────────────────

# ── API ───────────────────────────────────────────────────────────────────────
# Full base URL for the backend, INCLUDING the /api path segment.
# The axios client in src/utils/api.js calls paths like /auth/login, which
# are appended directly to this value.
REACT_APP_API_URL=http://localhost:5000/api

# Optional: override the default 30 s request timeout (milliseconds).
# REACT_APP_API_TIMEOUT_MS=30000

# ── Stellar Network ───────────────────────────────────────────────────────────
# Required in production. Set to 'mainnet' for live deployments.
# Omitting this in production will throw a startup error (FE-129).
REACT_APP_STELLAR_NETWORK=testnet

# Optional: override the Horizon API base URL.
# When unset, the value is derived from REACT_APP_STELLAR_NETWORK:
#   testnet → https://horizon-testnet.stellar.org
#   mainnet → https://horizon.stellar.org
# REACT_APP_STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org

# ── Federation ────────────────────────────────────────────────────────────────
# Federation addresses are only displayed when the backend provides
# user.federation_name in the profile response (FE-131).  The client no
# longer derives a federation address from the email local-part, so this
# variable is no longer read by the frontend — it is kept here for reference
# should a future backend feature need to advertise the federation domain.
# REACT_APP_FEDERATION_DOMAIN=afripay.com

# ── Monitoring ────────────────────────────────────────────────────────────────
# Sentry DSN for error tracking. Leave empty to disable.
REACT_APP_SENTRY_DSN=https://your-dsn@sentry.io/project-id

# ── Push Notifications ────────────────────────────────────────────────────────
# VAPID public key — must match VAPID_PUBLIC_KEY in the backend .env.
REACT_APP_VAPID_PUBLIC_KEY=your_vapid_public_key_here
